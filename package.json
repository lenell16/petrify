{
  "name": "petrify",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Download media you can view on Instagram with identifiable filenames.",
  "scripts": {
    "dev": "vite",
    "fixture:comments": "vite --config fixtures/vite.config.ts",
    "fixture:instagram": "vite --config fixtures/vite.config.ts",
    "build:fixture": "tsc -b && VITE_PETRIFY_FIXTURE=1 vite build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "companion": "node companion/cli.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@aws-sdk/s3-presigned-post": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "dotenv": "^18.0.4",
    "dropbox": "^10.47.0",
    "files-sdk": "^2.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.2"
  }
}
